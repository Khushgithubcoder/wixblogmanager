# Flask session secret
SESSION_SECRET=dev-session-secret-change-in-production

# AES-256 Encryption key for securing stored Wix API keys & OAuth tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# PostgreSQL Connection Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/wix_db

# Alternatively set individual connection variables:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=wix_db

# Optional: Wix App OAuth 2.0 Credentials (for 1-click App Market install flow)
WIX_APP_ID=
WIX_APP_SECRET=
WIX_REDIRECT_URI=http://localhost:5000/api/wix/oauth/callback

PORT=5000
